<?xml version="1.0"?>
<sdf version="1.9">
  <model name="shelf">
    <static>true</static>
    <link name="link">
      <pose>-0.2 0 0.3 0 0 0</pose>   <!-- shifts the box so the model's origin is the bottom centre of its FRONT face -->
      <visual name="visual">
        <geometry><box><size>0.4 0.8 0.6</size></box></geometry>
        <material>
          <diffuse>0.55 0.45 0.35 1</diffuse>
          <specular>0 0 0 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry><box><size>0.4 0.8 0.6</size></box></geometry>
      </collision>
    </link>
  </model>
</sdf>