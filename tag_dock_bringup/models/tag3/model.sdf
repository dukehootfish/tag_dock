<?xml version="1.0"?>
<sdf version="1.9">
  <model name="tag3">
    <static>true</static>                 <!-- fixed in place: no gravity, can't be pushed -->
    <link name="link">
      <visual name="visual">              <!-- what the camera sees -->
        <geometry>
          <box><size>0.002 0.2 0.2</size></box>   <!-- 2 mm thick, 20 cm wide, 20 cm tall -->
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>      <!-- white base, so the image keeps its true colours -->
          <specular>0 0 0 1</specular>    <!-- no shine: reflections hide the tag from the detector -->
          <pbr>
            <metal>
              <albedo_map>model://tag3/materials/textures/tag3.png</albedo_map>
              <metalness>0</metalness>
              <roughness>1</roughness>    <!-- matte, like printed paper -->
            </metal>
          </pbr>
        </material>
      </visual>
      <collision name="collision">        <!-- what the robot bumps into -->
        <geometry>
          <box><size>0.002 0.2 0.2</size></box>
        </geometry>
      </collision>
    </link>
  </model>
</sdf>